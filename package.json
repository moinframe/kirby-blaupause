{
	"name": "kirby-blaupause",
	"version": "0.0.0",
	"description": "Kirby Blaupause: A Starter Template",
	"main": "",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n types,vite 'pnpm:check' 'vite'",
		"build": "pnpm build:vite && pnpm css:purge",
		"build:vite": "vite build",
		"css:purge": "node scripts/purgecss.js || exit 1",
		"icons:build": "node scripts/svg-sprite.js -i frontend/assets/svg/ -o public/icons.svg",
		"check": "tsc --noEmit -p tsconfig.json",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"panel:dev": "pnpm --filter project-panel dev",
		"panel:build": "pnpm --filter project-panel build",
		"release": "release-it"
	},
	"keywords": [],
	"author": "Justus Kraft <justus@moinfra.me>",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@release-it/bumper": "^8.0.0",
		"@release-it/conventional-changelog": "^12.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.1.2",
		"browserslist": "^4.28.7",
		"concurrently": "^10.0.4",
		"glob": "^13.0.6",
		"laravel-vite-plugin": "^3.1.3",
		"lightningcss": "^1.33.0",
		"purgecss": "^8.0.0",
		"release-it": "^21.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svgo": "^4.0.2",
		"svgstore": "^3.0.1",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"yargs": "^18.1.0"
	},
	"dependencies": {
		"cleacss": "^3.2.0",
		"htmx.org": "^2.0.10",
		"lenis": "^1.3.25",
		"unlazy": "^2.0.1",
		"web-vitals": "^6.0.1"
	},
	"browserslist": [
		"last 2 versions",
		">= 0.4%",
		"not dead",
		"Firefox ESR",
		"not op_mini all",
		"not and_uc > 0"
	],
	"packageManager": "pnpm@11.18.0"
}
