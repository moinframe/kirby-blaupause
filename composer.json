{
	"name": "moinframe/kirby-blaupause",
	"description": "Kirby Blaupause: A Starter Template",
	"type": "project",
	"authors": [
		{
			"name": "Justus Kraft",
			"email": "justus@moinfra.me",
			"homepage": "https://moinfra.me"
		}
	],
	"homepage": "https://moinfra.me",
	"require": {
		"php": ">=8.0.0 <=8.6",
		"getkirby/cms": "^5",
		"lukaskleinschmidt/kirby-laravel-vite": "^2.2",
		"femundfilou/kirby-asset-manager": "^1.1",
		"getkirby/staticache": "^2.1",
		"getkirby/cli": "^1.9",
		"distantnative/retour-for-kirby": "^5.6",
		"bnomei/kirby3-dotenv": "^5.1",
		"timnarr/kirby-obfuscate-email": "^0.1.1",
		"junohamburg/kirby-visual-block-selector": "^3.0",
		"moinframe/kirby-panel-menu": "^1.0",
		"johannschopplich/kirby-serp-preview": "^1.3",
		"moinframe/kirby-image-snippet": "^2.0",
		"philippoehrlein/typo-and-paste": "^2.4",
		"grommasdietz/kirby-hidden-characters": "^2.1",
		"medienbaecker/kirby-help-view": "^1.3",
		"moinframe/kirby-accessibility-check": "^1.1",
		"junohamburg/kirby-language-selector": "^2.0"
	},
	"minimum-stability": "beta",
	"prefer-stable": true,
	"config": {
		"vendor-dir": "backend/vendor",
		"allow-plugins": {
			"getkirby/composer-installer": true
		},
		"optimize-autoloader": true
	},
	"extra": {
		"kirby-cms-path": "backend/kirby",
		"kirby-plugin-path": "backend/site/plugins"
	}
}
